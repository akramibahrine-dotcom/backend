# ---------- App ----------
APP_ENV=production
API_BASE_URL=https://api.baytseha.shop
FRONTEND_BASE_URL=https://baytseha.shop
CORS_ORIGINS=https://baytseha.shop,https://www.baytseha.shop
LOG_LEVEL=INFO

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@your_db_host:5432/your_db_name
RUN_MIGRATIONS_ON_START=true

# ---------- Admin Dashboard ----------
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# ---------- Proxy / Testing ----------
TRUST_PROXY_HEADERS=true
TEST_PHONE_WHITELIST=0501234987

# ---------- MaxMind minFraud ----------
# Account ID + minFraud license key (NOT a GeoIP2 db key).
# 403 = wrong creds, swapped ID/key, or key without minFraud service enabled.
MAXMIND_ACCOUNT_ID=REPLACE_WITH_VERIFIED_ID
MAXMIND_LICENSE_KEY=REPLACE_WITH_NEWLY_ROTATED_KEY
MAXMIND_MINFRAUD_ENDPOINT=https://minfraud.maxmind.com/minfraud/v2.0/insights
MAXMIND_MAX_RISK_SCORE=25
MAXMIND_MAX_IP_RISK=10
MAXMIND_ALLOWED_COUNTRIES=SA,AE,KW,QA,BH,OM,LB,IQ,LY
ANALYTICS_ALLOWED_COUNTRIES=SA,AE,KW,QA,BH,OM,LB,IQ,LY
MAXMIND_BLOCK_ANONYMOUS_IP=true
# 'allow' = accept orders if MaxMind is down (recommended for COD).
# 'reject' = block all orders during outages (kills checkout, not recommended).
FRAUD_PROVIDER_FAILURE_MODE=allow

# ---------- Google Sheets ----------
# Apps Script Web App deploy URL (no secret needed)
