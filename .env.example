APP_ENV=production
API_BASE_URL=https://api.Baytseha.shop
FRONTEND_BASE_URL=https://Baytseha.shop
CORS_ORIGINS=https://Baytseha.shop,https://www.Baytseha.shop

DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@PROJECT.SERVICE:5432/postgres
RUN_MIGRATIONS_ON_START=true

TEST_PHONE_WHITELIST=055000000
TRUST_PROXY_HEADERS=true

MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_MINFRAUD_ENDPOINT=https://minfraud.maxmind.com/minfraud/v2.0/insights
MAXMIND_MAX_RISK_SCORE=25
MAXMIND_MAX_IP_RISK=10
MAXMIND_BLOCK_NON_KSA=true
MAXMIND_BLOCK_ANONYMOUS_IP=true
FRAUD_PROVIDER_FAILURE_MODE=reject

GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=
SNAP_TEST_EVENT_CODE=
SEND_TEST_EVENTS=false

CURRENCY_API_URL=
CURRENCY_API_KEY=
DEFAULT_CURRENCY=SAR

LOG_LEVEL=INFO
