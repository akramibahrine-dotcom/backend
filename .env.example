MAXMIND_LICENSE_KEY=2Vkmtl_CQPSiZVbtEjyWXyA2V1PyLujjR37z_mm
MAXMIND_MINFRAUD_ENDPOINT=https://minfraud.maxmind.com/minfraud/v2.0/insights
MAXMIND_MAX_RISK_SCORE=25
MAXMIND_MAX_IP_RISK=10
MAXMIND_ALLOWED_COUNTRIES=SA,QA,BH,OM,LY,IQ,AE,LB,KW
MAXMIND_BLOCK_ANONYMOUS_IP=true
