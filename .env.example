# ---------- App ----------
APP_ENV=production
API_BASE_URL=https://api.baytseha.shop
FRONTEND_BASE_URL=https://baytseha.shop
CORS_ORIGINS=https://baytseha.shop,https://www.baytseha.shop
LOG_LEVEL=INFO

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_REAL_PASSWORD@REPLACE_WITH_DB_HOST:5432/postgres
RUN_MIGRATIONS_ON_START=true

# ---------- Proxy / Testing ----------
TRUST_PROXY_HEADERS=true
TEST_PHONE_WHITELIST=0501234987

# ---------- MaxMind minFraud ----------
# Account ID + minFraud license key (NOT a GeoIP2 db key).
# 403 = wrong creds, swapped ID/key, or key without minFraud service enabled.
MAXMIND_ACCOUNT_ID=REPLACE_WITH_VERIFIED_ID
MAXMIND_LICENSE_KEY=REPLACE_WITH_NEWLY_ROTATED_KEY
MAXMIND_MINFRAUD_ENDPOINT=https://minfraud.maxmind.com/minfraud/v2.0/insights
MAXMIND_MAX_RISK_SCORE=25
MAXMIND_MAX_IP_RISK=10
MAXMIND_ALLOWED_COUNTRIES=SA,QA,BH,OM,LY,IQ,AE,LB,KW
MAXMIND_BLOCK_ANONYMOUS_IP=true
# 'allow' = accept orders if MaxMind is down (recommended for COD).
# 'reject' = block all orders during outages (kills checkout, not recommended).
FRAUD_PROVIDER_FAILURE_MODE=allow

# ---------- Google Sheets ----------
# Apps Script Web App deploy URL (no secret needed)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxerStKxPmR_lPXpKSpYWPxrTHxNCBC4Oj5n-sV0lXpoW99L3aXKqaXUqbr5oSHPvpITw/exec

# ---------- Meta (FB/IG) ----------
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ---------- TikTok ----------
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# ---------- Snapchat ----------
SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=
SNAP_TEST_EVENT_CODE=

SEND_TEST_EVENTS=false

# ---------- Promos ----------
WELCOME_PROMO_CODES=عميل10,WELCOME10

# ---------- Currency ----------
CURRENCY_API_URL=
CURRENCY_API_KEY=
DEFAULT_CURRENCY=SAR
